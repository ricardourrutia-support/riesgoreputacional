/*
 * Huella de la data. Conserva la lógica original (filas x columnas), pero la guarda
 * durante el mismo tiempo que el resumen para no consultar seis hojas en cada request.
 * ↻ Recalcular usa force=true y vuelve a leer la huella inmediatamente.
 */
function _fingerprint(force) {
  var cache = CacheService.getScriptCache();
  if (!force) {
    var cached = cache.get(CACHE_KEY_FINGERPRINT);
    if (cached) return cached;
  }

  var names = [SH.LOSA, SH.JOURNEY, SH.PICKUP, SH.RESCATE, SH.PROG, SH.CONEX, SH.DOX];
  var parts = names.map(function (n) {
    try {
      var sh = _sheet(n);
      return sh.getLastRow() + 'x' + sh.getLastColumn();
    } catch (e) {
      return '0';
    }
  });
  /* Spreadsheet externo de abandonos */
  try {
    var sa = _sheet(SH.ABAN, ABANDONO_SHEET_ID);
    parts.push(sa.getLastRow() + 'x' + sa.getLastColumn());
  } catch (e) { parts.push('0'); }
  var sizes = parts.join('|');

  /* Versión opcional: marcarDatosActualizados() la cambia aunque el número de filas sea igual. */
  var manualVersion = PropertiesService.getScriptProperties().getProperty('DATA_VERSION') || '0';
  var fp = manualVersion + '|' + sizes;
  try { cache.put(CACHE_KEY_FINGERPRINT, fp, CACHE_TTL_FINGERPRINT); } catch (e) {}
  return fp;
}

function _ckey(prefix, parts) {
  return prefix + Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify(parts)));
}

/* Lee JSON simple o fragmentado desde CacheService. */
function _cacheGetJson(cache, key) {
  var raw = cache.get(key);
  if (!raw) return null;

  try {
    var parsed = JSON.parse(raw);
    if (!parsed || parsed.__chunked__ !== 1) return parsed;

    var keys = [];
    for (var i = 0; i < parsed.chunks; i++) keys.push(key + ':c' + i);
    var pieces = cache.getAll(keys);
    var json = '';
    for (var j = 0; j < keys.length; j++) {
      if (!(keys[j] in pieces)) return null; // expiró o falta un fragmento
      json += pieces[keys[j]];
    }
    return JSON.parse(json);
  } catch (e) {
    Logger.log('⚠️ Caché inválida para ' + key + ': ' + e.message);
    return null;
  }
}

/* Guarda JSON incluso cuando supera 100 KB, dividiéndolo en entradas pequeñas. */
function _cachePutJson(cache, key, value, ttlSec) {
  var json = JSON.stringify(value);
  try {
    if (json.length <= CACHE_CHUNK_CHARS) {
      cache.put(key, json, ttlSec);
      return { ok: true, chunks: 1, chars: json.length };
    }

    var chunks = Math.ceil(json.length / CACHE_CHUNK_CHARS);
    var entries = {};
    for (var i = 0; i < chunks; i++) {
      entries[key + ':c' + i] = json.substring(
        i * CACHE_CHUNK_CHARS,
        (i + 1) * CACHE_CHUNK_CHARS
      );
    }
    cache.putAll(entries, ttlSec);
    cache.put(key, JSON.stringify({ __chunked__: 1, chunks: chunks }), ttlSec);
    return { ok: true, chunks: chunks, chars: json.length };
  } catch (e) {
    Logger.log('⚠️ No se pudo guardar caché ' + key + ': ' + e.message);
    return { ok: false, chunks: 0, chars: json.length };
  }
}

/*
 * Útil al terminar una carga del Sapineitor. Cambia la versión aunque las hojas
 * conserven exactamente la misma cantidad de filas y columnas.
 * Puede ejecutarse manualmente o llamarse al final del proceso de carga.
 */
function marcarDatosActualizados() {
  PropertiesService.getScriptProperties().setProperty('DATA_VERSION', String(Date.now()));
  CacheService.getScriptCache().remove(CACHE_KEY_FINGERPRINT);
  _SS_ = {};
  _TBL_ = {};
  _SHIFT_ = null;
  _BASE_ = null;
  /* El cubo persistido queda obsoleto por clave, pero se borra igual para no
     dejar medio mega de JSON viejo ocupando la hoja. */
  try { var sh = _cuboHoja(false); if (sh) sh.clearContents(); } catch (e) {}
  Logger.log('✅ Versión de datos actualizada.');
}

/* Deja el resumen inicial caliente. Ideal: ejecutar después del Sapineitor. */
function precalentarCache() {
  var b = _monthBounds();
  var t0 = Date.now();
  _shift(true);
  _base(true);                       // <- lo caro: leer las hojas y agregar por bloque
  Logger.log('🧊 Cubo listo en ' + (Date.now() - t0) + ' ms');
  getSummary({
    dateFrom: b.defFrom,
    dateTo: b.max,
    hours: [],
    coordinator: '__ALL__',
    nocache: true,
    forceShift: true
  });
  Logger.log('✅ Caché precalentada: ' + b.defFrom + ' → ' + b.max);
}

/* ------------------------------------------------------------------ CUBO BASE
 * El costo real no era calcular, era LEER: cada recálculo transfería ~1,1 millones
 * de celdas (Conexiones sola aporta 600 mil). Antes eso se repetía ante cualquier
 * cambio de filtro, porque la caché estaba indexada por (fechas + horas + coordinador).
 *
 * Ahora se agrega UNA vez todo el horizonte a nivel de bloque (fecha × hora) y ese
 * cubo se cachea 6 h indexado solo por la huella de los datos. Filtrar por fecha,
 * hora o coordinador pasa a ser un recorrido en memoria sobre ~2.000 bloques.
 *
 * Los resultados son idénticos al cálculo directo porque los tres filtros operan a
 * nivel de bloque: sumar eventos y después filtrar bloques da lo mismo que filtrar
 * bloques y después sumar eventos.
 *
 * Estructura (compacta a propósito: viaja como JSON fragmentado en CacheService):
 *   dks        [ 'YYYY-MM-DD', ... ]                        índice de fechas
 *   fleets     [ 'Nombre flota', ... ]                      índice de flotas
 *   plates     [ 'PATENTE', ... ]                           índice de patentes
 *   blk        { 'dkIdx|hr': [17 contadores] }              KPIs por bloque
 *   fl         [ [flIdx, dkIdx, hr, prog, conn, whbProg, whbReal, whReal] ]
 *   pl         [ [flIdx, plIdx, dkIdx, progMask, connMask, seenMask] ]  máscaras de 24 bits
 */
const CACHE_TTL_BASE = 21600;   // 6 h: el tope de CacheService
const CACHE_KEY_BASE = 'airport_base_v2_';

/* Persistencia del cubo.
   CacheService NO sirve como almacén: desaloja entradas bajo presión y el cubo pesa
   ~500 KB repartidos en varios fragmentos, así que perder uno solo obligaba a releer
   1,1 millones de celdas. Ahora el cubo vive en una hoja oculta (almacenamiento real)
   y la caché queda solo como capa rápida delante. */
const CUBO_SHEET = '_Cubo';
const CUBO_CHUNK_CHARS = 45000;   // el límite por celda es 50.000 caracteres

/* Índices dentro de blk[]: legibles y sin costo en runtime. */
var B = { losaW:0, losaT:1, jrnW:2, jrnT:3, jrnDesW:4, jrnDesT:5, jrnHacW:6, jrnHacT:7,
          pkpW:8, pkpT:9, res:10, aban:11, whb:12, wh:13, whbProg:14, prog:15, conn:16,
          evento:17 };   // evento: 1 si el bloque debe aportar su fecha al eje del heatmap
const B_LEN = 18;

var _BASE_ = null;

/* Clave del cubo: huella de los datos + horizonte. El horizonte entra porque su tope
   es "hoy": al cambiar el día hay que reconstruir aunque las hojas no hayan crecido. */
function _cuboKey() {
  var b = _monthBounds();
  return _fingerprint(false) + '#' + b.min + '_' + b.max;
}

function _cuboHoja(crear) {
  var ss = _ss();
  var sh = ss.getSheetByName(CUBO_SHEET);
  if (!sh && crear) {
    sh = ss.insertSheet(CUBO_SHEET);
    sh.hideSheet();
    sh.getRange(1, 1).setNote('Cubo agregado del tablero. Lo escribe precalentarCache(). No editar a mano.');
  }
  return sh;
}

/* Estructura: A1 = clave · A2 = sello de tiempo · A3.. = fragmentos del JSON. */
function _cuboLeerHoja(key) {
  var sh = _cuboHoja(false);
  if (!sh) return null;
  var last = sh.getLastRow();
  if (last < 3) return null;
  var v = sh.getRange(1, 1, last, 1).getValues();
  if (String(v[0][0]) !== key) return null;        // datos o día cambiaron
  var json = '';
  for (var i = 2; i < v.length; i++) json += v[i][0];
  if (!json) return null;
  try { return JSON.parse(json); }
  catch (e) { Logger.log('⚠️ Cubo en hoja ilegible: ' + e.message); return null; }
}

function _cuboGuardarHoja(key, obj) {
  try {
    var sh = _cuboHoja(true);
    var json = JSON.stringify(obj);
    var filas = [[key], ['Escrito ' + new Date().toISOString() + ' · ' + json.length + ' caracteres']];
    for (var i = 0; i < json.length; i += CUBO_CHUNK_CHARS) {
      filas.push([json.substring(i, i + CUBO_CHUNK_CHARS)]);
    }
    if (sh.getMaxRows() < filas.length) sh.insertRowsAfter(sh.getMaxRows(), filas.length - sh.getMaxRows());
    sh.clearContents();
    sh.getRange(1, 1, filas.length, 1).setValues(filas);
    return json.length;
  } catch (e) {
    Logger.log('⚠️ No pude persistir el cubo: ' + e.message);
    return 0;
  }
}

/* Último origen del cubo, para el panel de tiempos de la UI. */
var _BASE_META_ = { origen: '-', ms: 0, bytes: 0 };

/* Tres niveles: memoria de la ejecución → CacheService → hoja oculta → reconstruir. */
function _base(force) {
  if (_BASE_ && !force) { _BASE_META_.origen = 'memoria'; _BASE_META_.ms = 0; return _BASE_; }

  var t0 = Date.now();
  var key = _cuboKey();
  var cache = CacheService.getScriptCache();

  if (!force) {
    var hit = _cacheGetJson(cache, CACHE_KEY_BASE + key);
    if (hit) {
      _BASE_META_ = { origen: 'caché', ms: Date.now() - t0, bytes: 0 };
      Logger.log('🧊 Cubo desde caché · ' + _BASE_META_.ms + ' ms');
      return (_BASE_ = hit);
    }
    var hoja = _cuboLeerHoja(key);
    if (hoja) {
      _BASE_META_ = { origen: 'hoja', ms: Date.now() - t0, bytes: 0 };
      Logger.log('🧊 Cubo desde hoja oculta · ' + _BASE_META_.ms + ' ms');
      /* Se repone en caché para que la próxima lectura sea aún más barata. */
      _cachePutJson(cache, CACHE_KEY_BASE + key, hoja, CACHE_TTL_BASE);
      return (_BASE_ = hoja);
    }
  }

  var out = _buildBase();
  var bytes = _cuboGuardarHoja(key, out);
  _cachePutJson(cache, CACHE_KEY_BASE + key, out, CACHE_TTL_BASE);
  _BASE_META_ = { origen: 'reconstruido', ms: Date.now() - t0, bytes: bytes };
  Logger.log('🧊 Cubo RECONSTRUIDO · ' + _BASE_META_.ms + ' ms · ' +
    Object.keys(out.blk).length + ' bloques · ' + Math.round(bytes / 1024) + ' KB');
  return (_BASE_ = out);
}

function _buildBase() {
  var b = _monthBounds();
  var minDk = b.min, maxDk = b.max;

  var dkIdx = {}, dks = [];
  function DK(dk) {
    if (dk in dkIdx) return dkIdx[dk];
    dkIdx[dk] = dks.length; dks.push(dk); return dks.length - 1;
  }
  var flIdx = {}, fleets = [];
  function FL(nm) {
    if (nm in flIdx) return flIdx[nm];
    flIdx[nm] = fleets.length; fleets.push(nm); return fleets.length - 1;
  }
  var plIdx = {}, plates = [];
  function PL(nm) {
    if (nm in plIdx) return plIdx[nm];
    plIdx[nm] = plates.length; plates.push(nm); return plates.length - 1;
  }

  var blk = {};
  function cell(dk, hr) {
    var k = DK(dk) + '|' + hr;
    var a = blk[k];
    if (!a) { a = blk[k] = []; for (var i = 0; i < B_LEN; i++) a[i] = 0; }
    return a;
  }
  function enRango(dk) { return dk >= minDk && dk <= maxDk; }
  function sw(seg, code) { return String(seg).trim().indexOf(code) === 0; }

  /* ---- KPI 2: tiempo en losa ---- */
  (function () {
    var t = _tbl(SH.LOSA);
    var seg = _col(t, COL.losaSeg, true), ts = _col(t, COL.losaTs, true);
    for (var r = 0; r < t.n; r++) {
      var s = seg[r]; if (s == null || s === '') continue;
      var d = _toDate(ts[r]); if (!d) continue;
      var dk = _dk(d); if (!enRango(dk)) continue;
      var a = cell(dk, d.getHours());
      a[B.losaT]++; a[B.evento] = 1;
      if (sw(s, '03.') || sw(s, '04.')) a[B.losaW]++;
    }
  })();

  /* ---- KPI 3: duración del journey, segmentada Desde / Hacia ---- */
  (function () {
    var t = _tbl(SH.JOURNEY);
    var seg = _col(t, COL.jrnSeg, true), ts = _col(t, COL.jrnTs, true);
    var dir = _col(t, COL.jrnDir, false);
    for (var r = 0; r < t.n; r++) {
      var s = seg[r]; if (s == null || s === '') continue;
      var d = _toDate(ts[r]); if (!d) continue;
      var dk = _dk(d); if (!enRango(dk)) continue;
      var a = cell(dk, d.getHours());
      var bad = sw(s, '04.');
      a[B.jrnT]++; a[B.evento] = 1;
      if (bad) a[B.jrnW]++;
      if (dir) {
        var dv = String(dir[r] || '').trim();
        if (dv.indexOf('Desde') === 0)      { a[B.jrnDesT]++; if (bad) a[B.jrnDesW]++; }
        else if (dv.indexOf('Hacia') === 0) { a[B.jrnHacT]++; if (bad) a[B.jrnHacW]++; }
      }
    }
  })();

  /* ---- KPI 4: puntualidad de pick up, solo Hacia Aeropuerto ---- */
  (function () {
    var t = _tbl(SH.PICKUP);
    var seg = _col(t, COL.pkpSeg, true), ts = _col(t, COL.pkpTs, true);
    var dir = _col(t, COL.pkpDir, false);
    for (var r = 0; r < t.n; r++) {
      if (dir && String(dir[r] || '').trim().indexOf('Hacia') !== 0) continue;
      var s = seg[r]; if (s == null || s === '') continue;
      var d = _toDate(ts[r]); if (!d) continue;
      var dk = _dk(d); if (!enRango(dk)) continue;
      var a = cell(dk, d.getHours());
      a[B.pkpT]++; a[B.evento] = 1;
      if (sw(s, '03.') || sw(s, '04.')) a[B.pkpW]++;
    }
  })();

  /* ---- Rescates ---- */
  (function () {
    var t = _tbl(SH.RESCATE);
    var ts = _col(t, COL.resTs, true);
    var cl = RESCATE_CLIENT_ID ? _col(t, COL.resClient, false) : null;
    for (var r = 0; r < t.n; r++) {
      if (cl && String(cl[r]).trim() !== RESCATE_CLIENT_ID) continue;
      var d = _toDate(ts[r]); if (!d) continue;
      var dk = _dk(d); if (!enRango(dk)) continue;
      var a = cell(dk, d.getHours());
      a[B.res]++; a[B.evento] = 1;
    }
  })();

  /* ---- Abandonos (spreadsheet externo) ---- */
  var abanWarning = '';
  (function () {
    try {
      var t = _tbl(SH.ABAN, ABANDONO_SHEET_ID);
      var af = _col(t, COL.abanFecha, false);
      var ah = _col(t, COL.abanHora, false);
      var at = _col(t, COL.abanTs, false);
      if (!af && !at) {
        abanWarning = 'La hoja de Abandonos no trae las columnas "Fecha"/"Hora" ni ' +
                      '"Date Time de Abandono". El KPI N° Abandonos queda en cero.';
        return;
      }
      for (var r = 0; r < t.n; r++) {
        var d = _abanDate(af, ah, at, r);
        if (!d) continue;
        var dk = _dk(d); if (!enRango(dk)) continue;
        var a = cell(dk, d.getHours());
        a[B.aban]++; a[B.evento] = 1;
      }
    } catch (e) {
      abanWarning = 'No pude leer el archivo de Abandonos (' + e.message + '). ' +
                    'El tablero funciona, pero sin el KPI N° Abandonos.';
    }
  })();

  /* ---- Conexiones Efectivas.
         Se indexa WHB y WH por patente y bloque: la pasada de Programación los usa para
         separar lo programado de lo real. Las filas sin Working Hours son duplicados
         del export y se descartan. ---- */
  var whbKey = {}, whKey = {}, seenKey = {};
  (function () {
    var t = _tbl(SH.CONEX);
    var dt = _col(t, COL.conexDate, true), hh = _col(t, COL.conexHour, true);
    var pl = _col(t, COL.conexPlate, true);
    var wb = _col(t, COL.conexWHB, false);
    var wh = _col(t, COL.conexWH, false);
    for (var r = 0; r < t.n; r++) {
      if (wh && (wh[r] === '' || wh[r] == null)) continue;
      var d = _toDate(dt[r]); if (!d) continue;
      var hr = Math.round(Number(hh[r])); if (isNaN(hr)) continue;
      var dk = _dk(d); if (!enRango(dk)) continue;
      var plate = _normPlate(pl[r]);
      var v = wb ? (Number(wb[r]) || 0) : 0;
      var w = wh ? (Number(wh[r]) || 0) : 0;
      var a = cell(dk, hr);
      a[B.whb] += v; a[B.wh] += w;
      if (plate) {
        var k = dk + '|' + hr + '|' + plate;
        whbKey[k] = (whbKey[k] || 0) + v;
        whKey[k]  = (whKey[k]  || 0) + w;
        seenKey[k] = true;
      }
    }
  })();

  /* ---- Programación: define qué patente pertenece a qué flota y qué debía conectarse ---- */
  var flAgg = {};                 // 'flIdx|dkIdx|hr' -> [prog, conn, whbProg, whbReal, whReal]
  var plAgg = {};                 // 'flIdx|plIdx|dkIdx' -> [progMask, connMask, seenMask]
  var plateFleet = {};            // patente -> flIdx (fuente autoritativa de pertenencia)

  (function () {
    var t;
    try { t = _tbl(SH.PROG); } catch (e) { return; }
    var dt = _col(t, COL.progDate, true), hh = _col(t, COL.progHour, true);
    var pl = _col(t, COL.progPlate, true);
    var fl = _col(t, COL.progFleet, false);
    var seen = {};
    for (var r = 0; r < t.n; r++) {
      var d = _toDate(dt[r]); if (!d) continue;
      var hr = Math.round(Number(hh[r])); if (isNaN(hr)) continue;
      var dk = _dk(d); if (!enRango(dk)) continue;
      var plate = _normPlate(pl[r]); if (!plate) continue;
      var slot = dk + '|' + hr + '|' + plate;
      if (seen[slot]) continue;
      seen[slot] = true;

      var fname = (fl ? String(fl[r] || '').trim() : '') || '(sin flota)';
      var fi = FL(fname), pi = PL(plate), di = DK(dk);
      plateFleet[plate] = fi;

      var ok = !!seenKey[slot];
      var wprog = whbKey[slot] || 0;

      var a = cell(dk, hr);
      a[B.prog]++; a[B.evento] = 1;
      if (ok) a[B.conn]++;
      a[B.whbProg] += wprog;

      var fk = fi + '|' + di + '|' + hr;
      var fa = flAgg[fk] || (flAgg[fk] = [0, 0, 0, 0, 0]);
      fa[0]++; if (ok) fa[1]++; fa[2] += wprog;

      var pk = fi + '|' + pi + '|' + di;
      var pa = plAgg[pk] || (plAgg[pk] = [0, 0, 0]);
      pa[0] |= (1 << hr);
      if (ok) pa[1] |= (1 << hr);
    }
  })();

  /* ---- Conexiones reales por flota (numerador y denominador de Saturación Neta).
         La pertenencia sale de Programación, no del nombre: 'Inversiones Bicofal Spa'
         en Programación es 'TRANSPORTE EMPRESA BICOFAL SPA' en Conexiones, y 33.862
         filas traen Company Name vacío, así que cruzar por nombre perdería datos. ---- */
  (function () {
    Object.keys(seenKey).forEach(function (k) {
      var p = k.split('|');
      var dk = p[0], hr = Number(p[1]), plate = p[2];
      var fi = plateFleet[plate];
      if (fi === undefined) fi = FL('(no programada)');
      var di = DK(dk);
      var fk = fi + '|' + di + '|' + hr;
      var fa = flAgg[fk] || (flAgg[fk] = [0, 0, 0, 0, 0]);
      fa[3] += (whbKey[k] || 0);
      fa[4] += (whKey[k]  || 0);

      var pi = PL(plate);
      var pk = fi + '|' + pi + '|' + di;
      var pa = plAgg[pk] || (plAgg[pk] = [0, 0, 0]);
      pa[2] |= (1 << hr);
    });
  })();

  /* ---- Aplanado para que el JSON sea lo más chico posible ---- */
  var fl = Object.keys(flAgg).map(function (k) {
    var p = k.split('|'), a = flAgg[k];
    return [Number(p[0]), Number(p[1]), Number(p[2]),
            a[0], a[1], _round(a[2], 4), _round(a[3], 4), _round(a[4], 4)];
  });
  var pl = Object.keys(plAgg).map(function (k) {
    var p = k.split('|'), a = plAgg[k];
    return [Number(p[0]), Number(p[1]), Number(p[2]), a[0], a[1], a[2]];
  });

  Object.keys(blk).forEach(function (k) {
    var a = blk[k];
    a[B.whb]     = _round(a[B.whb], 4);
    a[B.wh]      = _round(a[B.wh], 4);
    a[B.whbProg] = _round(a[B.whbProg], 4);
  });

  return { dks: dks, fleets: fleets, plates: plates, blk: blk, fl: fl, pl: pl,
           abanWarning: abanWarning };
}


/* ------------------------------------------------------------------ API: resumen + heatmap */
function getSummary(filters) {
  filters = filters || {};
  var started = Date.now();
  var cache = CacheService.getScriptCache();
  var forceData = !!filters.nocache;
  var key = _ckey('sum6_', [
    filters.dateFrom,
    filters.dateTo,
    filters.hours || [],
    filters.coordinator || '',
    _fingerprint(forceData)
  ]);

  if (!forceData) {
    var hit = _cacheGetJson(cache, key);
    if (hit) {
      hit.timings = { origenCubo: 'resumen en caché', msCubo: 0,
                      msTotal: Date.now() - started, kb: (hit.timings && hit.timings.kb) || 0 };
      Logger.log('✅ Summary cache HIT · ' + hit.timings.msTotal + ' ms');
      return hit;
    }
  }

  var out = _computeSummary(filters, !!filters.forceShift);
  var saved = _cachePutJson(cache, key, out, CACHE_TTL_SEC);
  out.timings = {
    origenCubo: _BASE_META_.origen,
    msCubo: _BASE_META_.ms,
    msTotal: Date.now() - started,
    kb: Math.round(saved.chars / 1024)
  };
  Logger.log('⚙️ Summary recalculado · ' + out.timings.msTotal + ' ms · cubo ' +
    out.timings.origenCubo + ' (' + out.timings.msCubo + ' ms) · ' + out.timings.kb + ' KB');
  return out;
}

/* ------------------------------------------------------------------ API: resumen + heatmap
 * Recorre el cubo base en memoria. No lee hojas salvo que el cubo esté frío.
 */
function _computeSummary(filters, forceShift) {
  var rng = _clampToMonth(filters.dateFrom, filters.dateTo);
  var from = rng.from, to = rng.to;

  var hoursSel = (filters.hours && filters.hours.length) ? filters.hours.map(Number) : null;
  var coord = (filters.coordinator && filters.coordinator !== '__ALL__') ? filters.coordinator : null;

  var shift = _shift(forceShift);
  var shiftMap = shift.map;
  var base = _base(false);

  /* Máscara de horas pedidas (24 bits). */
  var hourMask = 0;
  if (hoursSel) hoursSel.forEach(function (h) { hourMask |= (1 << h); });
  else hourMask = 0xFFFFFF;

  /* Por cada fecha del cubo, las horas realmente en alcance: rango + franjas + turno
     del coordinador. Con esto, filtrar deja de ser condicional y pasa a ser bitwise. */
  var allow = {};                       // dkIdx -> máscara de horas permitidas
  base.dks.forEach(function (dk, di) {
    if (dk < from || dk > to) { allow[di] = 0; return; }
    var m = hourMask;
    if (coord) {
      var cm = 0;
      for (var h = 0; h < 24; h++) {
        var cs = shiftMap[dk + '|' + h];
        if (cs && cs.indexOf(coord) >= 0) cm |= (1 << h);
      }
      m &= cm;
    }
    allow[di] = m;
  });
  function permitido(di, hr) { return (allow[di] & (1 << hr)) !== 0; }

  var losaW = 0, losaT = 0, jrnW = 0, jrnT = 0, pkpW = 0, pkpT = 0, res = 0, aban = 0;
  var jrnDesW = 0, jrnDesT = 0, jrnHacW = 0, jrnHacT = 0;
  var whbTot = 0, whTot = 0, whbProg = 0, progTot = 0, connTot = 0;
  var cells = {}, dateSet = {}, byCoord = {};

  function coordBag(nm) {
    return byCoord[nm] || (byCoord[nm] = {
      losaW: 0, losaT: 0, jrnW: 0, jrnT: 0, pkpW: 0, pkpT: 0,
      res: 0, aban: 0, whb: 0, wh: 0, whbProg: 0, prog: 0, conn: 0
    });
  }

  /* Coordinadores de turno dentro del alcance: aparecen aunque no registren eventos. */
  Object.keys(shiftMap).forEach(function (k) {
    var p = k.split('|'), dk = p[0], hr = Number(p[1]);
    if (dk < from || dk > to) return;
    if (!(hourMask & (1 << hr))) return;
    if (coord && shiftMap[k].indexOf(coord) < 0) return;
    shiftMap[k].forEach(function (nm) { coordBag(nm); });
  });

  /* ---- Bloques ---- */
  Object.keys(base.blk).forEach(function (k) {
    var p = k.split('|'), di = Number(p[0]), hr = Number(p[1]);
    if (!permitido(di, hr)) return;
    var a = base.blk[k], dk = base.dks[di];

    losaW += a[B.losaW]; losaT += a[B.losaT];
    jrnW  += a[B.jrnW];  jrnT  += a[B.jrnT];
    jrnDesW += a[B.jrnDesW]; jrnDesT += a[B.jrnDesT];
    jrnHacW += a[B.jrnHacW]; jrnHacT += a[B.jrnHacT];
    pkpW  += a[B.pkpW];  pkpT  += a[B.pkpT];
    res   += a[B.res];   aban  += a[B.aban];
    whbTot += a[B.whb];  whTot += a[B.wh];
    whbProg += a[B.whbProg];
    progTot += a[B.prog]; connTot += a[B.conn];

    if (a[B.evento]) dateSet[dk] = true;

    cells[dk + '|' + hr] = {
      res: a[B.res],
      aban: a[B.aban],
      losa: a[B.losaT] ? a[B.losaW] / a[B.losaT] : null,
      jrn:  a[B.jrnT]  ? a[B.jrnW]  / a[B.jrnT]  : null,
      pkp:  a[B.pkpT]  ? a[B.pkpW]  / a[B.pkpT]  : null,
      whb:  _round(a[B.whb], 2),
      satProg: a[B.prog] ? a[B.whbProg] / a[B.prog] : null,
      satNeta: a[B.wh]   ? a[B.whb]     / a[B.wh]   : null,
      prog: a[B.prog],
      conn: a[B.conn],
      w: { losa: a[B.losaW], jrn: a[B.jrnW], pkp: a[B.pkpW] },
      n: { losa: a[B.losaT], jrn: a[B.jrnT], pkp: a[B.pkpT] }
    };

    /* Atribución al coordinador de turno: íntegra a cada uno del bloque. */
    var cs = shiftMap[dk + '|' + hr];
    if (cs) {
      for (var i = 0; i < cs.length; i++) {
        var b = coordBag(cs[i]);
        b.losaW += a[B.losaW]; b.losaT += a[B.losaT];
        b.jrnW  += a[B.jrnW];  b.jrnT  += a[B.jrnT];
        b.pkpW  += a[B.pkpW];  b.pkpT  += a[B.pkpT];
        b.res   += a[B.res];   b.aban  += a[B.aban];
        b.whb   += a[B.whb];   b.wh    += a[B.wh];
        b.whbProg += a[B.whbProg];
        b.prog  += a[B.prog];  b.conn  += a[B.conn];
      }
    }
  });

  /* ---- Flotas: métricas por (flota, fecha, hora) ---- */
  var byFleet = {};
  function fleetBag(fi) {
    return byFleet[fi] || (byFleet[fi] = {
      prog: 0, conn: 0, whbProg: 0, whbReal: 0, whReal: 0,
      plates: {}, platesConn: {}, sin: {}, miss: {}, missN: 0
    });
  }
  base.fl.forEach(function (row) {
    var fi = row[0], di = row[1], hr = row[2];
    if (!permitido(di, hr)) return;
    var f = fleetBag(fi);
    f.prog += row[3]; f.conn += row[4];
    f.whbProg += row[5]; f.whbReal += row[6]; f.whReal += row[7];
  });

  /* ---- Patentes: cumplimiento y detalle de lo no conectado, vía máscaras de hora ---- */
  var progPlates = {}, progPlatesConn = {}, plateSeenAny = {};
  base.pl.forEach(function (row) {
    var fi = row[0], pi = row[1], di = row[2];
    var m = allow[di]; if (!m) return;
    var progM = row[3] & m, connM = row[4] & m, seenM = row[5] & m;
    if (!progM && !seenM) return;

    var plate = base.plates[pi];
    if (seenM) plateSeenAny[plate] = true;
    if (!progM) return;

    var f = fleetBag(fi);
    f.plates[plate] = true;
    progPlates[plate] = true;
    if (connM) { f.platesConn[plate] = true; progPlatesConn[plate] = true; }

    /* Horas programadas sin conexión: el detalle que se despliega en el panel. */
    var missM = progM & ~connM;
    if (missM) {
      var dk = base.dks[di];
      var arr = f.miss[plate] || (f.miss[plate] = []);
      for (var h = 0; h < 24; h++) {
        if (missM & (1 << h)) { arr.push(dk + '|' + h); f.missN++; }
      }
    }
  });

  var dates = Object.keys(dateSet).sort();
  var hours = hoursSel ? hoursSel.slice().sort(function (a, b) { return a - b; }) : _allHours();

  var coordsOut = Object.keys(byCoord).sort().map(function (nm) {
    var b = byCoord[nm];
    return {
      name: nm,
      losa: b.losaT ? b.losaW / b.losaT : null, losaW: b.losaW, losaN: b.losaT,
      jrn:  b.jrnT  ? b.jrnW  / b.jrnT  : null, jrnW:  b.jrnW,  jrnN:  b.jrnT,
      pkp:  b.pkpT  ? b.pkpW  / b.pkpT  : null, pkpW:  b.pkpW,  pkpN:  b.pkpT,
      res:  b.res,
      aban: b.aban,
      whb:  _round(b.whb, 1),
      satProg: b.prog ? b.whbProg / b.prog : null,
      satNeta: b.wh   ? b.whb     / b.wh   : null,
      prog: b.prog,
      conn: b.conn
    };
  });

  var coverage = Object.keys(byFleet).map(function (fi) {
    var f = byFleet[fi];
    var np = Object.keys(f.plates).length;
    var nc = Object.keys(f.platesConn).length;

    /* Patentes programadas que no figuran en el export de conexiones en TODO el alcance. */
    var ns = 0;
    Object.keys(f.plates).forEach(function (pl) { if (!plateSeenAny[pl]) ns++; });

    var noconn = Object.keys(f.miss).map(function (pl) {
      var arr = f.miss[pl].sort();
      return { plate: pl, n: arr.length,
               when: arr.slice(0, COVERAGE_MAX_BLOQUES),
               mas: Math.max(0, arr.length - COVERAGE_MAX_BLOQUES) };
    }).sort(function (a, b) { return b.n - a.n; }).slice(0, COVERAGE_MAX_PATENTES);

    return {
      fleet: base.fleets[fi],
      prog: f.prog, conn: f.conn,
      plates: np, platesConn: nc, sinRegistro: ns,
      noconnN: f.missN,
      noconnPlates: Object.keys(f.miss).length,
      noconn: noconn,
      cumpl: np ? nc / np : null,
      satProg: f.prog ? f.whbProg / f.prog : null,
      satNeta: f.whReal ? f.whbReal / f.whReal : null,
      whbReal: _round(f.whbReal, 1),
      whReal: _round(f.whReal, 1)
    };
  }).filter(function (f) { return f.prog > 0 || f.whReal > 0; })
    .sort(function (a, b) { return b.prog - a.prog; });

  var nPlates = Object.keys(progPlates).length;
  var nPlatesConn = Object.keys(progPlatesConn).length;

  var ciegas = coverage.filter(function (f) { return f.plates > 0 && f.sinRegistro === f.plates; });
  var parciales = coverage.filter(function (f) { return f.sinRegistro > 0 && f.sinRegistro < f.plates; });

  var dataWarning = '';
  if (ciegas.length) {
    dataWarning = 'El export "WH Busy By Patente" no trae ningún registro para ' +
      ciegas.map(function (f) { return f.fleet; }).join(', ') +
      '. Esas vans programadas se cuentan como "no conectadas" aunque hayan trabajado, ' +
      'así que la tasa de conexión está subestimada.';
  } else if (parciales.length) {
    var faltan = 0;
    parciales.forEach(function (f) { faltan += f.sinRegistro; });
    dataWarning = faltan + ' patentes programadas no aparecen en el export de conexiones. ' +
      'Revisa el filtro del CSV "WH Busy By Patente" antes de tomar la tasa de conexión como definitiva.';
  }

  return {
    cards: {
      losa: losaT ? losaW / losaT : null, losaW: losaW, losaN: losaT,
      jrn:  jrnT  ? jrnW  / jrnT  : null, jrnW:  jrnW,  jrnN:  jrnT,
      jrnDes: jrnDesT ? jrnDesW / jrnDesT : null, jrnDesW: jrnDesW, jrnDesN: jrnDesT,
      jrnHac: jrnHacT ? jrnHacW / jrnHacT : null, jrnHacW: jrnHacW, jrnHacN: jrnHacT,
      pkp:  pkpT  ? pkpW  / pkpT  : null, pkpW:  pkpW,  pkpN:  pkpT,
      res:  res,
      aban: aban,
      whb:  _round(whbTot, 1),
      wh:   _round(whTot, 1),
      whbProg: _round(whbProg, 1),
      satProg: progTot ? whbProg / progTot : null,
      satNeta: whTot ? whbTot / whTot : null,
      prog: progTot,
      conn: connTot,
      noconn: progTot - connTot,
      connRate: progTot ? connTot / progTot : null,
      cumplPlates: nPlatesConn,
      cumplPlatesN: nPlates,
      cumpl: nPlates ? nPlatesConn / nPlates : null
    },
    byCoord: coordsOut,
    coverage: coverage,
    heatmap: { dates: dates, hours: hours, cells: cells },
    filters: { from: from, to: to, coord: coord || 'Todos' },
    shiftWarning: shift.error || '',
    dataWarning: dataWarning,
    abanWarning: base.abanWarning || ''
  };
}

/* ------------------------------------------------------------------ API: detalle de celda
   Lectura POR BANDA: se ubica el tramo de filas del bloque con las columnas de fecha/hora y
   solo entonces se leen las demás columnas de ese tramo. */
function getCellDetail(dk, hr, coordinator) {
  hr = Number(hr);
  var cache = CacheService.getScriptCache();
  var key = _ckey('det3_', [dk, hr, coordinator || '', _fingerprint(false)]);
  var hit = _cacheGetJson(cache, key);
  if (hit) return hit;

  var coord = (coordinator && coordinator !== '__ALL__') ? coordinator : null;
  var coords = _shift(false).map[dk + '|' + hr] || [];
  var blockOk = !coord || coords.indexOf(coord) >= 0;

  /* --- Rescates --- */
  var rescates = (function () {
    var cols = ['Start At Local Dttm', 'Product Name', 'Start Neighborhood',
                'Dirección de inicio', 'Canal de DO', 'Company Id', 'Journey Id', 'End State'];
    var out = { rows: [], cols: cols };
    if (!blockOk) return out;

    var t = _tbl(SH.RESCATE);
    var band = _band(t, dk, hr, { ts: COL.resTs });
    if (!band) return out;

    var ts = _colBand(t, COL.resTs, band.start, band.count);
    var cl = RESCATE_CLIENT_ID ? _colBand(t, COL.resClient, band.start, band.count) : null;
    var colData = cols.map(function (c) { return _colBand(t, c, band.start, band.count); });

    for (var i = 0; i < band.count; i++) {
      if (cl && String(cl[i]).trim() !== RESCATE_CLIENT_ID) continue;
      var d = _toDate(ts[i]); if (!d) continue;
      if (_dk(d) !== dk || d.getHours() !== hr) continue;
      var row = {};
      cols.forEach(function (c, j) {
        var val = colData[j] ? colData[j][i] : '';
        if (val instanceof Date) {
          val = _dk(val) + ' ' + _p2(val.getHours()) + ':' + _p2(val.getMinutes()) + ':' + _p2(val.getSeconds());
        }
        row[c] = (val == null ? '' : val);
      });
      out.rows.push(row);
    }
    return out;
  })();

  /* --- Abandonos del bloque (spreadsheet externo).
         Sin lectura por banda: la hoja es chica y no viene ordenada por fecha. --- */
  var abandonos = (function () {
    var cols = ['Date Time de Abandono', 'Id_Reserva', 'Número de ticket', 'Monto a Compensar',
                'Tipo Compensación', 'Motivo Compensación', 'Origen fecha'];
    var out = { rows: [], cols: cols };
    if (!blockOk) return out;
    try {
      var t = _tbl(SH.ABAN, ABANDONO_SHEET_ID);
      var af = _col(t, COL.abanFecha, false);
      var ah = _col(t, COL.abanHora, false);
      var at = _col(t, COL.abanTs, false);
      var colData = cols.map(function (c) { return _col(t, c, false); });
      for (var i = 0; i < t.n; i++) {
        var d = _abanDate(af, ah, at, i);
        if (!d) continue;
        if (_dk(d) !== dk || d.getHours() !== hr) continue;
        var row = {};
        cols.forEach(function (c, j) {
          var val = colData[j] ? colData[j][i] : '';
          if (val instanceof Date) val = _dk(val) + ' ' + _p2(val.getHours()) + ':' + _p2(val.getMinutes());
          row[c] = (val == null ? '' : val);
        });
        out.rows.push(row);
      }
    } catch (e) {
      Logger.log('Detalle de abandonos no disponible: ' + e.message);
    }
    return out;
  })();

  /* --- Drop Offs del bloque (Doxproductname) -> { PATENTE: {productos, dos} }.
         Es el cruce que permite ver QUÉ estaba haciendo cada van conectada. --- */
  var doxByPlate = (function () {
    var map = {};
    try {
      var t = _tbl(SH.DOX);
      var band = _band(t, dk, hr, { ts: COL.doxTs });
      if (!band) return map;

      var ts = _colBand(t, COL.doxTs, band.start, band.count);
      var pl = _colBand(t, COL.doxPlate, band.start, band.count);
      var pn = _colBand(t, COL.doxProduct, band.start, band.count);
      var nd = _colBand(t, COL.doxCount, band.start, band.count);
      if (!ts || !pl) return map;

      for (var i = 0; i < band.count; i++) {
        var d = _toDate(ts[i]); if (!d) continue;
        if (_dk(d) !== dk || d.getHours() !== hr) continue;
        var plate = _normPlate(pl[i]); if (!plate) continue;
        var prod = pn ? String(pn[i] || '').trim() : '';
        if (!prod) prod = '(sin producto)';
        /* '# DO' viene por fila; si falta, cada fila cuenta como 1 Drop Off. */
        var q = nd ? (Number(nd[i]) || 0) : 0;
        if (!q) q = 1;
        var m = map[plate] || (map[plate] = { by: {}, dos: 0 });
        m.by[prod] = (m.by[prod] || 0) + q;
        m.dos += q;
      }
    } catch (e) {
      Logger.log('Cruce con Doxproductname no disponible: ' + e.message);
    }
    return map;
  })();

  /* Resume el mix de una patente: 'GROUPING SHARED ×2 · Van Negra ×1' */
  function _doxLabel(plate) {
    var m = doxByPlate[plate];
    if (!m) return '';
    return Object.keys(m.by)
      .sort(function (a, b) { return m.by[b] - m.by[a]; })
      .map(function (k) { return k + ' ×' + m.by[k]; })
      .join(' · ');
  }

  /* --- Conexiones Efectivas (todos los productos; el producto sale del sufijo de la patente) --- */
  var plateSet = {};
  var conex = (function () {
    var cols = ['Patente', 'Producto', 'Flota', 'Driver Name',
                'Working Hours', 'Working Hours Busy', 'Drop Offs', 'Productos DO'];
    var sum = { N: _bag(), C: _bag(), X: _bag() };
    function pack(b) { return { wh: _round(b.wh, 2), whb: _round(b.whb, 2), vans: Object.keys(b.vans).length }; }
    var out = {
      rows: [], cols: cols,
      summary: { N: pack(sum.N), C: pack(sum.C), X: pack(sum.X) },
      totals: { wh: 0, whb: 0, vans: 0 }
    };
    if (!blockOk) return out;

    var t = _tbl(SH.CONEX);
    var band = _band(t, dk, hr, { date: COL.conexDate, hour: COL.conexHour });
    if (!band) return out;

    var dt = _colBand(t, COL.conexDate, band.start, band.count);
    var hh = _colBand(t, COL.conexHour, band.start, band.count);
    var pl = _colBand(t, COL.conexPlate, band.start, band.count);
    var co = _colBand(t, COL.conexCompany, band.start, band.count) ||
             _colBand(t, COL.conexCompanyFb, band.start, band.count);
    var dr = _colBand(t, COL.conexDriver, band.start, band.count);
    var wh = _colBand(t, COL.conexWH, band.start, band.count);
    var wb = _colBand(t, COL.conexWHB, band.start, band.count);

    var whSum = 0, whbSum = 0, vanSet = {};

    for (var i = 0; i < band.count; i++) {
      if (wh && (wh[i] === '' || wh[i] == null)) continue;   // duplicados sin WH
      var d = _toDate(dt[i]); if (!d) continue;
      if (_dk(d) !== dk) continue;
      if (Math.round(Number(hh[i])) !== hr) continue;

      var raw = String(pl[i] || '').trim(); if (!raw) continue;
      var norm = _normPlate(raw);
      plateSet[norm] = true;
      vanSet[norm] = true;

      var prod = _prodOf(raw);
      var whV  = wh ? (Number(wh[i]) || 0) : 0;
      var whbV = wb ? (Number(wb[i]) || 0) : 0;

      whSum += whV; whbSum += whbV;

      out.rows.push({
        'Patente': norm,
        'Producto': prod,
        'Flota': co ? String(co[i] || '').trim() : '',
        'Driver Name': dr ? String(dr[i] || '') : '',
        'Working Hours': _round(whV, 3),
        'Working Hours Busy': _round(whbV, 3),
        'Drop Offs': doxByPlate[norm] ? doxByPlate[norm].dos : 0,
        'Productos DO': _doxLabel(norm)
      });

      var b = sum[prod] || sum.X;
      b.wh += whV; b.whb += whbV; b.vans[norm] = true;
    }

    out.summary = { N: pack(sum.N), C: pack(sum.C), X: pack(sum.X) };
    out.totals = { wh: _round(whSum, 2), whb: _round(whbSum, 2), vans: Object.keys(vanSet).length };
    return out;
  })();

  /* --- Programación del bloque: vans programadas y su estado --- */
  var prog = (function () {
    var out = {
      rows: [], cols: ['Patente', 'Flota', 'Bloque Asignado', 'Estado', 'Drop Offs', 'Productos DO'],
      summary: { prog: 0, conn: 0, noconn: 0 }
    };
    if (!blockOk) return out;

    var t;
    try { t = _tbl(SH.PROG); } catch (e) { return out; }
    var band = _band(t, dk, hr, { date: COL.progDate, hour: COL.progHour });
    if (!band) return out;

    var dt = _colBand(t, COL.progDate, band.start, band.count);
    var hh = _colBand(t, COL.progHour, band.start, band.count);
    var pl = _colBand(t, COL.progPlate, band.start, band.count);
    var fl = _colBand(t, COL.progFleet, band.start, band.count);
    var bl = _colBand(t, COL.progBloque, band.start, band.count);

    var seen = {};
    for (var i = 0; i < band.count; i++) {
      var d = _toDate(dt[i]); if (!d) continue;
      if (_dk(d) !== dk) continue;
      if (Math.round(Number(hh[i])) !== hr) continue;
      var plate = _normPlate(pl[i]); if (!plate || seen[plate]) continue;
      seen[plate] = true;
      out.rows.push({
        'Patente': plate,
        'Flota': fl ? String(fl[i] || '').trim() : '',
        'Bloque Asignado': bl ? String(bl[i] || '') : '',
        'Estado': plateSet[plate] ? 'Conectada' : 'No se conectó',
        'Drop Offs': doxByPlate[plate] ? doxByPlate[plate].dos : 0,
        'Productos DO': _doxLabel(plate)
      });
    }

    out.rows.sort(function (a, b) {
      if (a.Estado !== b.Estado) return a.Estado === 'No se conectó' ? -1 : 1;
      return a.Patente < b.Patente ? -1 : 1;
    });

    var conn = 0;
    out.rows.forEach(function (r) { if (r.Estado === 'Conectada') conn++; });
    out.summary = { prog: out.rows.length, conn: conn, noconn: out.rows.length - conn };
    return out;
  })();

  var result = { dk: dk, hr: hr, coords: coords, rescates: rescates,
                 abandonos: abandonos, conex: conex, prog: prog };
  _cachePutJson(cache, key, result, CACHE_TTL_SEC);
  return result;
}

/* ------------------------------------------------------------------ Diagnóstico */
function diagnostico() {
  var b = _monthBounds();
  Logger.log('📅 Rango seleccionable: ' + b.min + ' → ' + b.max + ' | por defecto desde ' + b.defFrom);

  var s = _shift(true);
  Logger.log('👥 Coordinadores: ' + (s.coords.join(', ') || '(ninguno)'));
  Logger.log('🕐 Bloques con coordinador de turno (sin franjas administrativas): ' +
    Object.keys(s.map).length);
  if (s.error) Logger.log('⚠️ ' + s.error);

  [SH.LOSA, SH.JOURNEY, SH.PICKUP, SH.RESCATE, SH.PROG, SH.CONEX, SH.DOX].forEach(function (n) {
    try {
      var sh = _sheet(n);
      Logger.log('📄 ' + sh.getName() + ': ' + (sh.getLastRow() - 1) + ' filas');
    } catch (e) {
      Logger.log('❌ ' + (Array.isArray(n) ? n[0] : n) + ': ' + e.message);
    }
  });

  /* Abandonos: spreadsheet externo */
  try {
    var sa = _sheet(SH.ABAN, ABANDONO_SHEET_ID);
    var ta = _tbl(SH.ABAN, ABANDONO_SHEET_ID);
    var faltan = [COL.abanFecha, COL.abanHora, COL.abanTs].filter(function (c) { return !(c in ta.hmap); });
    Logger.log('📄 Abandonos / ' + sa.getName() + ': ' + (sa.getLastRow() - 1) + ' filas' +
      (faltan.length ? ' | ⚠️ faltan columnas: ' + faltan.join(', ') : ''));
  } catch (e) {
    Logger.log('❌ Abandonos: ' + e.message);
  }

  /* Columnas necesarias para el cruce de Drop Offs */
  try {
    var td = _tbl(SH.DOX);
    var faltanDox = [COL.doxTs, COL.doxPlate, COL.doxProduct]
      .filter(function (c) { return !(c in td.hmap); });
    Logger.log(faltanDox.length
      ? '⚠️ Doxproductname: faltan columnas para el cruce: ' + faltanDox.join(', ')
      : '✅ Doxproductname: columnas del cruce OK');
  } catch (e) {
    Logger.log('❌ Doxproductname: ' + e.message);
  }
}

/* util */
function _bag() { return { wh: 0, whb: 0, vans: {} }; }
function _allHours() { var a = []; for (var i = 0; i < 24; i++) a.push(i); return a; }
function _round(x, d) { var f = Math.pow(10, d || 0); return Math.round((Number(x) || 0) * f) / f; }
